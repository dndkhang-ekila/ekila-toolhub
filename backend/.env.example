TOOLHUB_DOMAINS=localhost
URL_POLICY_EXTRA_SHORTENER_DOMAINS=
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_PATH=data/toolhub.sqlite
JWT_SECRET=toolhub-jwt-secret-key-fr-acc-01-secure-2026
JWT_EXPIRES_IN=7d

# Cấu hình SMTP gửi Email giao dịch OTP (SRS Table 8)
# Với Gmail: nhập email Gmail vào SMTP_USER và App Password (16 ký tự) vào SMTP_PASS.
# Nếu để trống MAIL_FROM, hệ thống tự dùng "ToolHub" <SMTP_USER> để tránh bị Gmail chặn địa chỉ .local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PASSWORD_RESET_MAIL_MODE=local
PASSWORD_RESET_MAIL_DIR=data/mailbox
PASSWORD_RESET_WORKER_ENABLED=true
PASSWORD_RESET_MAILBOX_PORT=8025
PASSWORD_RESET_MAIL_KEY=
SMTP_FROM=
SMTP_PASSWORD=
